{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/client",
    "installCommand": "npm install",
    "devCommand": "npm run dev",
    "framework": null,
    "functions": {
        "dist/server/server.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/assets/(.*)", "destination": "/assets/$1" },
        { "source": "/(.*)", "destination": "/dist/server/server.js" }
    ]
}
